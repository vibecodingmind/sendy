# ==============================================================================
# Monogram Mail SaaS - Production Environment Configuration
# ==============================================================================

# Application Runtime
NODE_ENV="production"
PORT=3010
APP_NAME="Monogram Mail"
APP_URL="https://app.monogrammail.com"
SUPPORT_EMAIL="support@monogrammail.com"

# Security & Authentication
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-ultra-secure-random-secret-key-at-least-64-characters"

# Control Plane Database (PostgreSQL recommended for production)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://mailoo:your-strong-db-password@127.0.0.1:5432/mailoo_saas?schema=public"

# Mail Engine Provider: 'iredmail' for live mail servers, 'mock' for local testing
MAIL_PROVIDER="iredmail"

# Primary iRedMail MySQL / PostgreSQL Database Connection
IREDMAIL_DB_TYPE="mysql"
IREDMAIL_DB_HOST="mail.monogrammail.com"
IREDMAIL_DB_PORT=3306
IREDMAIL_DB_NAME="vmail"
IREDMAIL_DB_USER="vmailadmin"
IREDMAIL_DB_PASSWORD="your-iredmail-mysql-password"
IREDMAIL_STORAGE_NODE="vmail1"

# Customer Mail Client Hostnames & Ports
MAIL_IMAP_HOST="imap.monogrammail.com"
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST="smtp.monogrammail.com"
MAIL_SMTP_PORT=587
MAIL_MX_HOST="mx1.monogrammail.com"
MAIL_MX_PRIORITY=10
MAIL_DKIM_SELECTOR="default"
MAIL_WEBMAIL_URL="https://mail.monogrammail.com"

# Stripe Recurring Billing
PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY="sk_live_51..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# System Outbound Transactional Emails (for password resets, invoice alerts)
SYSTEM_SMTP_HOST="smtp.monogrammail.com"
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER="notifications@monogrammail.com"
SYSTEM_SMTP_PASSWORD="your-smtp-app-password"
SYSTEM_FROM_EMAIL="notifications@monogrammail.com"

# Background Scheduled Cron Secret Token (for Cloud Scheduler / systemd curl)
# Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="generate-a-strong-cron-secret-token"

# Payment webhook verification (required in production)
AZAMPAY_WEBHOOK_SECRET="generate-a-strong-azampay-callback-secret"

# Outbound abuse limits (built-in webmail simulation + API)
MAX_HOURLY_EMAILS_PER_MAILBOX="250"

# Anti-Abuse Thresholds
MAX_FAILED_LOGINS=5
MAX_HOURLY_EMAILS_PER_MAILBOX=250
