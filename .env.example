# Central Application & Brand Configuration
APP_NAME="Monogram Mail"
APP_URL="http://localhost:3010"
PORT=3010
APP_ENV="development"

# Security & Sessions
JWT_SECRET="dev-super-secure-jwt-secret-key-replace-in-production-min-32-chars"
COOKIE_SECRET="dev-cookie-secret-min-32-chars-long"

# Primary Database (SQLite for local dev/testing, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Mail Infrastructure Hostnames & Ports
MAIL_WEBMAIL_URL="https://mail.monogrammail.com"
MAIL_IMAP_HOST="imap.monogrammail.com"
MAIL_IMAP_PORT="993"
MAIL_SMTP_HOST="smtp.monogrammail.com"
MAIL_SMTP_PORT="465"
MAIL_MX_HOST="mx1.monogrammail.com"
MAIL_MX_PRIORITY="10"
MAIL_DKIM_SELECTOR="default"

# Active Mail Provider: "mock" (for tests/local) or "iredmail" (production)
MAIL_PROVIDER="mock"

# Production iRedMail Database Connection (PostgreSQL or MySQL vmail DB)
IREDMAIL_DB_TYPE="mysql"
IREDMAIL_DB_HOST="127.0.0.1"
IREDMAIL_DB_PORT="3306"
IREDMAIL_DB_USER="vmailadmin"
IREDMAIL_DB_PASSWORD="change_me_to_vmail_password"
IREDMAIL_DB_NAME="vmail"
IREDMAIL_STORAGE_NODE="vmail1"

# Payment Gateway Configuration
PAYMENT_PROVIDER="azampay" # "mock", "stripe", or "azampay"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLIC_KEY=""

# AzamPay Payment Gateway (https://developerdocs.azampay.co.tz)
AZAMPAY_APP_NAME="MonogramMail"
AZAMPAY_CLIENT_ID=""
AZAMPAY_CLIENT_SECRET=""
AZAMPAY_API_KEY=""
AZAMPAY_BASE_URL="https://sandbox.azampay.co.tz"
AZAMPAY_AUTH_URL="https://authenticator-sandbox.azampay.co.tz"
AZAMPAY_CALLBACK_URL="http://localhost:3010/api/v1/billing/webhook/azampay"
AZAMPAY_WEBHOOK_SECRET="change-me-azampay-callback-secret-min-32-chars"
AZAMPAY_USD_TO_TZS_RATE="2700"
# Set to "true" to simulate USSD confirmation in local development without active webhook tunnel
AZAMPAY_SIMULATE="true"

# Cron & rate limits (required in production)
CRON_SECRET="dev-cron-secret-change-in-production"
MAX_HOURLY_EMAILS_PER_MAILBOX="100"

# Support & System Settings
SUPPORT_EMAIL="support@monogrammail.com"
TERMS_URL="/terms"
PRIVACY_URL="/privacy"
